{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "backend-service-input/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "featureId", "stack", "serviceRoot", "consumer", "openapi", "testCases", "database", "performance", "scope"],
  "properties": {
    "schemaVersion": {"const": "backend-service-input/v1"},
    "featureId": {"type": "string", "minLength": 1},
    "stack": {"enum": ["java-spring", "python-fastapi", "generic"]},
    "serviceRoot": {"type": "string", "minLength": 1},
    "consumer": {"type": "object", "additionalProperties": false, "required": ["repositoryRoot", "baseline"], "properties": {"repositoryRoot": {"type": "string", "minLength": 1}, "baseline": {"type": "object", "additionalProperties": false, "required": ["commit"], "properties": {"commit": {"type": "string", "minLength": 1}}}}},
    "openapi": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "approvedVersion", "baseline"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "approvedVersion": {"type": "string", "minLength": 1}, "baseline": {"type": ["string", "null"]}}},
    "testCases": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}},
    "database": {"type": "object", "additionalProperties": false, "required": ["required", "migrationTool"], "properties": {"required": {"type": "boolean"}, "reason": {"type": "string", "minLength": 1}, "engine": {"type": "string"}, "changelogRoot": {"type": "string", "minLength": 1}, "migrationTool": {"type": "string", "minLength": 1}}},
    "performance": {"type": "object", "additionalProperties": false, "required": ["required"], "properties": {"required": {"type": "boolean"}, "reason": {"type": "string", "minLength": 1}, "baseUrlEnv": {"type": "string", "minLength": 1}, "profiles": {"type": "array", "items": {"enum": ["smoke", "baseline", "stress"]}, "uniqueItems": true}, "scenarios": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["operationId", "profile"], "properties": {"operationId": {"type": "string"}, "profile": {"type": "array", "items": {"enum": ["smoke", "baseline", "stress"]}, "uniqueItems": true}}}}}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["allowedPaths", "protectedPaths"], "properties": {"allowedPaths": {"type": "array"}, "protectedPaths": {"type": "array"}}}
  }
}
